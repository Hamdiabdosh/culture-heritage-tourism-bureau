# PostgreSQL connection string (required for app + migrations)
# Local Docker Compose example (host maps container 5432 → 55432):
# DATABASE_URL=postgresql://gov:gov@localhost:55432/gov_website
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Better Auth — generate a long random secret for production
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Public base URL of this app (no trailing slash) — must match the browser origin
# Local: http://localhost:3000 (or :3001/:3002 if Next picks another port)
# Production: https://your-institution.example.gov.et
BETTER_AUTH_URL=http://localhost:3000

# Active institution UUID from the institutions table (required for CMS content)
# Create/find one with: pnpm db:bootstrap-institution
INSTITUTION_ID=

# Production bootstrap (pnpm db:bootstrap-admin with NODE_ENV=production):
# ADMIN_EMAIL and ADMIN_PASSWORD are required — no defaults in production.
# Local development may omit them (script uses local-only defaults).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=CMS Admin
